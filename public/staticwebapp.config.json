{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/*.png", "/*.svg", "/*.ico", "/*.txt", "/*.xml", "/*.json", "/*.webmanifest"]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "mimeTypes": { ".json": "application/json", ".xml": "application/xml" }
}
